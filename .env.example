# Redis. On Vercel, add Upstash Redis from the Storage tab and these are set for you.
# Leave empty locally to use the in-memory test store (boosted odds, milestone 20).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Public URL of the deployed site, used for social previews.
NEXT_PUBLIC_SITE_URL=

# Optional tuning (defaults shown are the production values).
# MILESTONE=50000
# ODDS_BOOST=1
# VISIT_COOLDOWN_SECONDS=1800
# ROLL_COOLDOWN_SECONDS=25
# IP_VISITS_PER_HOUR=60

# Set to 1 to let the Sightings screen preview moments you haven't seen.
NEXT_PUBLIC_DEV_TOOLS=
