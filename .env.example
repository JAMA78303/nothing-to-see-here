# Supabase project (Settings → API). Leave both empty to run in local test mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the deployed site, used for share links and social previews.
NEXT_PUBLIC_SITE_URL=

# Set to 1 to let the Sightings screen preview moments you haven't seen.
NEXT_PUBLIC_DEV_TOOLS=
